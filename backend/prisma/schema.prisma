generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  STUDENT
  TEACHER
  EXTERNAL
  ADMINISTRATIVE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum ItemStatus {
  AVAILABLE
  UNAVAILABLE
  LOST
}

enum MovementType {
  BORROW
  RETURN
  LOSS_REPORT
}


enum ItemType {
  KEY
  KIT
}


model Admin {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     AdminRole @default(ADMIN)

  movements Movement[]
}

model User {
  id       Int    @id @default(autoincrement())
  fullName String
  phone    String
  role     Role   @default(STUDENT)

  movements Movement[] @relation("UserMovements")

  authorizationsReceived Authorization[] @relation("StudentAuth")

  authorizationsGiven Authorization[] @relation("TeacherAuth")

  authorizedMovements Movement[] @relation("TeacherMovements")
}


model Room {
  id          Int     @id @default(autoincrement())
  name        String  
  number      String  
  block       String  

  items          Item[]
  authorizations Authorization[]
}


model Item {
  id     Int        @id @default(autoincrement())
  name   String   
  code   String     
  type   ItemType   
  status ItemStatus @default(AVAILABLE)

  
  roomId Int
  room   Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)

  movements      Movement[]
  
}


model Authorization {
  id Int @id @default(autoincrement())

  studentId Int
  student   User @relation("StudentAuth", fields: [studentId], references: [id], onDelete: Cascade)

  teacherId Int
  teacher   User @relation("TeacherAuth", fields: [teacherId], references: [id], onDelete: Cascade)

  
  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}



model Movement {
  id        Int          @id @default(autoincrement())
  type      MovementType
  createdAt DateTime     @default(now())

  
  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

 
  userId Int?
  user   User? @relation("UserMovements", fields: [userId], references: [id], onDelete: SetNull)

  
  teacherId Int?
  teacher   User? @relation("TeacherMovements", fields: [teacherId], references: [id], onDelete: SetNull)

  
  itemId Int?
  item   Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)
}
