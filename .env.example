# Host e portas publicados no servidor
APP_HOST=localhost
BACKEND_PORT=3000
FRONTEND_PORT=5173

# URLs externas usadas pelo frontend e CORS
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Banco de dados
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=db_chaves
DATABASE_URL=postgresql://admin:change-this-db-password@db:5432/db_chaves?schema=public

# Segurança
JWT_SECRET=generate-a-long-random-secret
NODE_ENV=development
ADMIN_SEED_PASSWORD=change-this-admin-password
